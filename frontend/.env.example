# Copy to .env (git-ignored) and adjust.
# Base URL of the CodePulse FastAPI backend. There is no default.
VITE_API_BASE_URL=http://localhost:8000
# "true" shows clearly labelled sample fixtures instead of calling the API.
# Set to false (or remove) to use the real API. Failures are never replaced by fixtures.
VITE_USE_MOCK=true
